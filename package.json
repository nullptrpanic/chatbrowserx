{
  "name": "chatbrowserx",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.18.0 <25 || >=26.0.0 <27"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "format": "prettier --single-quote --print-width 100 --write .",
    "format:check": "prettier --single-quote --print-width 100 --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "npm run build && playwright test --config e2e/playwright.config.ts",
    "test:e2e:built": "playwright test --config e2e/playwright.config.ts",
    "test:e2e:quick": "npm run build && playwright test --config e2e/playwright.config.ts --project=translation --no-deps --grep @smoke --max-failures=1",
    "e2e:catalog:validate": "tsx e2e/runner/validate.ts",
    "e2e:env:doctor": "npm run build && tsx e2e/runner/doctor.ts",
    "e2e:benchmark:compare": "tsx e2e/runner/compare.ts",
    "e2e:live:setup": "npm run build && tsx e2e/runner/setup.ts",
    "e2e:live:verify": "npm run build && tsx e2e/runner/verify.ts",
    "e2e:live:seed-product": "npm run build && tsx e2e/runner/seed-product-settings.ts",
    "e2e:live:benchmark": "npm run build && tsx e2e/runner/benchmark.ts",
    "e2e:live:provider-diagnose": "npm run build && tsx e2e/runner/provider-diagnose.ts",
    "audit:bundle": "tsx scripts/audit-production-bundle.ts",
    "check:codex": "tsx scripts/check-codex-contract.ts",
    "check:sandbox": "tsx scripts/check-sandbox-integration.ts"
  },
  "dependencies": {
    "idb": "8.0.4",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "3.0.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/chrome": "0.3.6",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "devtools-protocol": "^0.0.1724436",
    "eslint": "10.13.0",
    "fake-indexeddb": "6.2.6",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true
  }
}
