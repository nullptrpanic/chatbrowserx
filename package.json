{
  "name": "chatbrowserx",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.18.0 <25 || >=26.0.0 <27"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "format": "prettier --single-quote --print-width 100 --write .",
    "format:check": "prettier --single-quote --print-width 100 --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "npm run build && playwright test --config e2e/playwright.config.ts",
    "e2e:catalog:validate": "tsx e2e/runner/validate.ts",
    "e2e:env:doctor": "npm run build && tsx e2e/runner/doctor.ts",
    "e2e:benchmark:compare": "tsx e2e/runner/compare.ts",
    "e2e:live:setup": "npm run build && tsx e2e/runner/setup.ts",
    "e2e:live:verify": "npm run build && tsx e2e/runner/verify.ts",
    "e2e:live:seed-product": "npm run build && tsx e2e/runner/seed-product-settings.ts",
    "e2e:live:run": "npm run build && tsx e2e/runner/run.ts",
    "e2e:live:benchmark": "npm run build && tsx e2e/runner/benchmark.ts",
    "e2e:live:provider-diagnose": "npm run build && tsx e2e/runner/provider-diagnose.ts",
    "audit:bundle": "tsx scripts/audit-production-bundle.ts",
    "check:codex": "tsx scripts/check-codex-contract.ts",
    "check:sandbox": "tsx scripts/check-sandbox-integration.ts"
  },
  "dependencies": {
    "idb": "8.0.3",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "2.7.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.4",
    "@types/chrome": "0.2.6",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "5.2.0",
    "devtools-protocol": "^0.0.1672245",
    "eslint": "10.8.1",
    "fake-indexeddb": "6.2.5",
    "globals": "17.11.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true
  }
}
